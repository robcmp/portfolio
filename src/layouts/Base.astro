---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import displayLatin from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { t, profile, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site).href;
const esUrl = new URL('/', site).href;
const enUrl = new URL('/en/', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Frontend & Full Stack Engineer',
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  sameAs: [profile.linkedin, profile.github],
  url: canonical,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <meta name="theme-color" content="#070807" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- The hero display type is the LCP element: start its latin subset early. -->
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Apply the stored motion preference before first paint to avoid a flash of animation. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('rmendoza:motion');
          var off = s === 'off' || (s !== 'on' && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
          document.documentElement.classList.toggle('motion-off', off);
          document.documentElement.dataset.motion = off ? 'off' : 'on';
        } catch (e) {}
      })();
    </script>
    <noscript>
      <style>[data-reveal]{opacity:1!important;transform:none!important}.crt{display:none}</style>
    </noscript>
  </head>
  <body class="overflow-x-hidden bg-void text-fg">
    <div class="grid-bg" aria-hidden="true"></div>
    <slot />
    <div class="crt" aria-hidden="true"></div>
  </body>
</html>
